// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum UserStatus {
  active
  disabled
}

enum UserRole {
  admin
  user
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String 
  email        String   @unique
  phone        String  @unique
  password     String
  confirmPassword String
  role         UserRole @default(user)

  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  deletedById Int?
  deletedBy   User? @relation("DeletedBy", fields: [deletedById], references: [id])

  deletedUsers User[] @relation("DeletedBy")

  status UserStatus @default(active)

  passwordResetToken   String?
  passwordResetExpires DateTime?

  isVerified Boolean @default(false)

  emailVerificationToken   String?
  emailVerificationExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account      Account?
}



enum AccountStatus {
  active
  frozen
  closed
}

model Account {
  id               Int           @id @default(autoincrement())
  accountNumber    String        @unique
  balance          Decimal
  availableBalance Decimal
  currency         String
  status           AccountStatus @default(active)
  apiBaseUrl        String

  userId           Int           @unique
  user             User          @relation(fields: [userId], references: [id])

  ledgerEntries    LedgerEntry[]
  refundRequests RefundRequest[]
  apiKeys          APIKey[]
  linkedCards LinkedCard[]

  moneyRequestsSent     MoneyRequest[] @relation("MoneyRequestRequester")
  moneyRequestsReceived MoneyRequest[] @relation("MoneyRequestRecipient")

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

}


enum APIKeyStatus {
  active
  revoked
}

model APIKey {
  id        Int          @id @default(autoincrement())
  name      String

  apiKey    String       @unique
  apiSecret String

  status    APIKeyStatus @default(active)

  accountId Int
  account   Account      @relation(fields: [accountId], references: [id])

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([accountId])
}



enum TransactionType {
  transfer
  deposit
  withdrawal
  payment
  refund
  fee
}

enum TransactionStatus {
  pending
  processing
  completed
  failed
  cancelled
  reversed
}

model Transaction {
  id          Int               @id @default(autoincrement())
  reference   String            @unique

  type        TransactionType
  status      TransactionStatus @default(pending)

  amount      Decimal           @db.Decimal(19, 4)
  currency    String            @db.VarChar(3)
  description String?

  ledgerEntries LedgerEntry[]
  refundRequest RefundRequest?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}


enum LedgerEntryType {
  debit
  credit
}

model LedgerEntry {
  id            Int               @id @default(autoincrement())

  transactionId Int
  transaction   Transaction       @relation(fields: [transactionId] , references: [id])

  accountId     Int
  account       Account           @relation(fields: [accountId] , references: [id])

  type          LedgerEntryType
  amount        Decimal           @db.Decimal(19, 4)
  currency      String            @db.VarChar(3)

  createdAt     DateTime          @default(now())

  @@index([transactionId])
  @@index([accountId])
  @@index([createdAt])
}



enum MoneyRequestStatus {
  pending
  accepted
  rejected
  cancelled
}


model MoneyRequest {
  id                 Int                @id @default(autoincrement())
  amount             Decimal            @db.Decimal(19, 4)
  currency           String             @db.VarChar(3)
  description        String?
  status             MoneyRequestStatus @default(pending)

  requesterAccountId Int
  recipientAccountId Int

  requester          Account            @relation("MoneyRequestRequester", fields: [requesterAccountId], references: [id])
  recipient          Account            @relation("MoneyRequestRecipient", fields: [recipientAccountId], references: [id])

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([requesterAccountId])
  @@index([recipientAccountId])
  @@index([status])
}


enum LinkedCardStatus {
  ACTIVE
  BLOCKED
  EXPIRED
  CANCELED
}

enum CardBrand {
  VISA
  MASTERCARD
}

model LinkedCard {
  id          Int    @id @default(autoincrement())

  token       String @unique
  brand       CardBrand
  last4       String
  expMonth    Int
  expYear     Int
  status      LinkedCardStatus @default(ACTIVE)

  accountId   Int
  account     Account @relation(fields: [accountId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
}